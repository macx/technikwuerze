# VCS and CI
.git/
.github/

# local dependencies/tooling
node_modules/
.env
.env.*

# local-only migration workspace
migration/
build/

# runtime-managed content and state
content/
media/
public/media/
site/accounts/
site/cache/
site/sessions/
storage/

# host-managed HTTP auth secrets (e.g. Mittwald Verzeichnisschutz)
.htpasswd
public/.htpasswd

# host-managed Kirby license (never present on CI runner checkout; excluding
# it stops rsync --delete from wiping the activated license on the server)
site/config/.license

# local dev/runtime files
.DS_Store
*.log
